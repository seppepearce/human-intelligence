# Multi-stage build for SvelteKit frontend with Neo4j integration
FROM node:18-alpine AS base

# Install dependencies needed for building native modules
RUN apk add --no-cache libc6-compat python3 make g++ curl

# Set working directory
WORKDIR /app

# Development stage
FROM base AS development

# Install development tools
RUN apk add --no-cache git bash vim

# Create app user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S sveltekit -u 1001 -G nodejs

# Copy package files
COPY package*.json ./
COPY pnpm-lock.yaml* ./

# Install pnpm
RUN npm install -g pnpm@latest

# Install dependencies
RUN pnpm install --frozen-lockfile

# Create necessary directories
RUN mkdir -p /app/.svelte-kit /app/build /app/static \
    && chown -R sveltekit:nodejs /app

# Copy source code
COPY --chown=sveltekit:nodejs . .

# Set proper permissions
RUN chown -R sveltekit:nodejs /app

# Switch to non-root user
USER sveltekit

# Expose ports
EXPOSE 3000 3001

# Environment variables for development
ENV NODE_ENV=development
ENV ORIGIN=http://localhost:3000
ENV HMR_PORT=3001

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:3000 || exit 1

# Development command with hot reloading
CMD ["pnpm", "dev", "--host", "0.0.0.0", "--port", "3000"]

# Builder stage
FROM base AS builder

# Install pnpm
RUN npm install -g pnpm@latest

# Copy package files
COPY package*.json ./
COPY pnpm-lock.yaml* ./

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy source code
COPY . .

# Build arguments
ARG VITE_API_URL=http://localhost:8080
ARG VITE_WS_URL=ws://localhost:8080
ARG VITE_NEO4J_BROWSER_URL=http://localhost:7474
ARG VITE_AI_SERVICE_URL=http://localhost:8000

# Set build environment variables
ENV NODE_ENV=production
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_WS_URL=$VITE_WS_URL
ENV VITE_NEO4J_BROWSER_URL=$VITE_NEO4J_BROWSER_URL
ENV VITE_AI_SERVICE_URL=$VITE_AI_SERVICE_URL

# Build the application
RUN pnpm build

# Remove development dependencies
RUN pnpm prune --prod

# Production stage
FROM node:18-alpine AS production

# Install runtime dependencies
RUN apk add --no-cache curl

# Create app user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S sveltekit -u 1001 -G nodejs

# Set working directory
WORKDIR /app

# Copy built application from builder stage
COPY --from=builder --chown=sveltekit:nodejs /app/build ./build
COPY --from=builder --chown=sveltekit:nodejs /app/package.json ./
COPY --from=builder --chown=sveltekit:nodejs /app/node_modules ./node_modules

# Copy static files
COPY --from=builder --chown=sveltekit:nodejs /app/static ./static

# Switch to non-root user
USER sveltekit

# Expose port
EXPOSE 3000

# Environment variables for production
ENV NODE_ENV=production
ENV ORIGIN=https://your-domain.com
ENV PORT=3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:3000 || exit 1

# Production command
CMD ["node", "build"]

# Preview stage (for testing production build locally)
FROM production AS preview

# Switch back to development user for preview
USER sveltekit

# Environment for preview
ENV NODE_ENV=production
ENV ORIGIN=http://localhost:3000
ENV PORT=3000

# Preview command
CMD ["node", "build"]
