{
  "name": "human-intelligence-frontend",
  "version": "0.0.1",
  "description": "Human Intelligence - A collaborative learning platform with AI augmentation",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --plugin-search-dir . --check . && eslint .",
    "format": "prettier --plugin-search-dir . --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.28.1",
    "@sveltejs/adapter-auto": "^6.0.1",
    "@sveltejs/kit": "^2.22.0",
    "@tailwindcss/forms": "^0.5.6",
    "@tailwindcss/typography": "^0.5.10",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.28.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-svelte": "^2.30.0",
    "postcss": "^8.4.31",
    "prettier": "^2.8.0",
    "prettier-plugin-svelte": "^2.10.1",
    "svelte": "^4.0.5",
    "svelte-check": "^3.4.3",
    "tailwindcss": "^3.3.5",
    "tslib": "^2.4.1",
    "typescript": "^5.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.4",
    "@vitest/ui": "^3.2.4"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.5.3",
    "@tabler/icons-svelte": "^2.47.0",
    "clsx": "^2.0.0",
    "d3": "^7.8.5",
    "date-fns": "^2.30.0",
    "highlight.js": "^11.9.0",
    "katex": "^0.16.8",
    "lucide-svelte": "^0.263.0",
    "marked": "^5.1.2",
    "socket.io-client": "^4.7.4",
    "svelte-french-toast": "^1.0.3",
    "svelte-headless-table": "^0.18.1",
    "svelte-persisted-store": "^0.9.0",
    "tailwind-merge": "^1.14.0",
    "zod": "^3.22.4"
  },
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "learning",
    "education",
    "ai",
    "collaboration",
    "forum",
    "svelte",
    "sveltekit",
    "real-time"
  ],
  "author": "HI Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/human-intelligence.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/human-intelligence/issues"
  },
  "homepage": "https://github.com/your-org/human-intelligence#readme"
}
