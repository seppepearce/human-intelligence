# =============================================================================
# Human Intelligence - Comprehensive .gitignore
# =============================================================================

# =============================================================================
# ENVIRONMENT & CONFIG FILES
# =============================================================================
.env
.env.local
.env.development
.env.test
.env.production
.env.*.local
*.env
config.local.*

# =============================================================================
# DEPENDENCIES
# =============================================================================

# Go dependencies
vendor/
go.work
go.work.sum

# Node.js dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Package manager files
.npm
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# =============================================================================
# BUILD ARTIFACTS & OUTPUT
# =============================================================================

# Go build artifacts
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
bin/
build/
dist/

# Node.js build artifacts
.svelte-kit/
.output/
.vercel/
.netlify/
.nuxt/
.vuepress/dist
.next/
out/

# SvelteKit specific
/build
/package
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# =============================================================================
# DEVELOPMENT TOOLS
# =============================================================================

# Air (Go hot reload)
tmp/
.air.toml.local

# Coverage reports
coverage/
*.lcov
.nyc_output
coverage.txt
coverage.html
coverage.out

# Testing
test-results/
playwright-report/
.jest-cache/

# =============================================================================
# DATABASE & STORAGE
# =============================================================================

# Database files
*.db
*.sqlite
*.sqlite3
*.db-journal

# Upload directories
uploads/
static/uploads/
temp/
.tmp/

# Backup files
*.bak
*.backup
*.dump

# =============================================================================
# LOGS & TEMPORARY FILES
# =============================================================================

# Log files
*.log
logs/
pids
*.pid
*.seed
*.pid.lock

# Runtime data
lib-cov
.grunt
.lock-wscript

# Temporary files
*.tmp
*.temp
.cache
.parcel-cache

# =============================================================================
# IDE & EDITOR FILES
# =============================================================================

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr

# Sublime Text
*.sublime-workspace
*.sublime-project

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

# =============================================================================
# OS GENERATED FILES
# =============================================================================

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.fseventsd
.TemporaryItems
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# =============================================================================
# DOCKER & CONTAINERIZATION
# =============================================================================

# Docker volumes and data
docker-data/
postgres_data/
redis_data/
elasticsearch_data/
prometheus_data/
grafana_data/
localai_data/

# Docker override files
docker-compose.override.yml
docker-compose.*.override.yml

# =============================================================================
# AI & ML MODELS
# =============================================================================

# AI model files
ai-models/
models/
*.bin
*.gguf
*.ggml
*.safetensors
*.onnx
*.tflite
*.h5
*.pkl
*.joblib

# Large model caches
.cache/huggingface/
.cache/torch/
.ollama/

# =============================================================================
# MONITORING & ANALYTICS
# =============================================================================

# Monitoring data
monitoring/data/
metrics/
analytics/

# =============================================================================
# DEPLOYMENT & CI/CD
# =============================================================================

# Deployment artifacts
.vercel
.netlify
.aws-sam/
.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl

# CI/CD secrets
.secrets/
secrets.yaml
secrets.yml

# =============================================================================
# DOCUMENTATION
# =============================================================================

# Generated documentation
docs/build/
docs/_build/
docs/.vuepress/dist/
site/

# =============================================================================
# MISCELLANEOUS
# =============================================================================

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# Storybook build outputs
.out
.storybook-out

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional stylelint cache
.stylelintcache

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# =============================================================================
# PROJECT SPECIFIC
# =============================================================================

# Human Intelligence specific
hi-data/
hi-uploads/
hi-cache/
hi-logs/

# Plugin development
plugins/dev/
plugins/temp/

# User generated content (in development)
user-content/
sample-data/

# Performance profiling
*.prof
*.pprof

# =============================================================================
# SECURITY
# =============================================================================

# Private keys and certificates
*.pem
*.key
*.crt
*.csr
*.p12
*.pfx

# OAuth and API keys (just in case)
*secret*
*token*
*api-key*
*oauth*

# But allow specific config files
!.github/
!.vscode/extensions.json
!.env.example
!.env.template

# =============================================================================
# KEEP THESE FILES
# =============================================================================

# Force include important files
!.gitkeep
!.htaccess
!.well-known/

ai/
